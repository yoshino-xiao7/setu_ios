<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Supplementary Info.plist merged on top of the generated one
	  (GENERATE_INFOPLIST_FILE=YES). UIBackgroundModes is not produced by any
	  INFOPLIST_KEY_* build setting, so it must live here for background audio
	  to actually work; without it iOS suspends the app and playback stops.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Fixed login-proxy hosts use a per-session pinned local anchor.
	     TLS 1.2+, forward secrecy and native upstream verification remain enforced. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>app-api.pixiv.net</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>accounts.pixiv.net</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>oauth.secure.pixiv.net</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>www.pixiv.net</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>i.pximg.net</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>s.pximg.net</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>i-cf.pximg.net</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
		</dict>
	</dict>
</dict>
</plist>
